# -------------------------------------------------------------------------- #
#
# calulator -- Quartus settings for the K9DTV CPLD Development System board.
# Original project created March 22, 2018 (Quartus Prime 17.1.1 / II 13.0 SP1).
# 2026: desktop-absolute .bdf paths removed; rebuildable Verilog + board device.
#
# -------------------------------------------------------------------------- #

set_global_assignment -name FAMILY MAX7000AE
set_global_assignment -name DEVICE EPM7064AELC44-10
set_global_assignment -name TOP_LEVEL_ENTITY calulator
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 17.1.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "19:25:30  MARCH 22, 2018"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name DEVICE_FILTER_PACKAGE PLCC
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 44
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR "-1"

# Rebuildable source (replaces missing desktop .bdf schematic set)
set_global_assignment -name VERILOG_FILE calulator.v

# -------------------------------------------------------------------------- #
# Ver2 board pin map (silkscreen revision)
# DIP SW1..SW12 active-low; clock from on-board 555; dual TIL311 hex
# -------------------------------------------------------------------------- #

# SW1 .. SW12
set_location_assignment PIN_4  -to sw_n[0]
set_location_assignment PIN_5  -to sw_n[1]
set_location_assignment PIN_6  -to sw_n[2]
set_location_assignment PIN_8  -to sw_n[3]
set_location_assignment PIN_9  -to sw_n[4]
set_location_assignment PIN_12 -to sw_n[5]
set_location_assignment PIN_11 -to sw_n[6]
set_location_assignment PIN_14 -to sw_n[7]
set_location_assignment PIN_16 -to sw_n[8]
set_location_assignment PIN_17 -to sw_n[9]
set_location_assignment PIN_19 -to sw_n[10]
set_location_assignment PIN_18 -to sw_n[11]

set_location_assignment PIN_24 -to clk

# Display nibble: A / B / C / D
set_location_assignment PIN_27 -to hex_nibble[0]
set_location_assignment PIN_25 -to hex_nibble[1]
set_location_assignment PIN_26 -to hex_nibble[2]
set_location_assignment PIN_28 -to hex_nibble[3]

set_location_assignment PIN_29 -to blank
set_location_assignment PIN_33 -to right_le
set_location_assignment PIN_36 -to left_le
set_location_assignment PIN_34 -to right_dp
set_location_assignment PIN_31 -to left_dp
